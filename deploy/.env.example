# Moraine production environment. Copy to .env and chmod 600.
# Keep this file private; Compose passes these values to the server.

# Public URL used in verification and email links.
MORAINE_PUBLIC_URL=https://registry.example.com

# PostgreSQL metadata database. Use a long random value.
MORAINE_POSTGRES_PASSWORD=

# Leave registration closed initially. Publishing stays review-gated.
MORAINE_REGISTRATION=closed
MORAINE_PUBLISHING=review

# Optional: require verified email before uploads/submissions.
# MORAINE_REQUIRE_VERIFIED_EMAIL=true

# Backblaze B2 S3-compatible storage. Keep the bucket private.
MORAINE_S3_BUCKET=
MORAINE_S3_ENDPOINT=https://s3.<region>.backblazeb2.com
MORAINE_S3_REGION=
MORAINE_S3_ACCESS_KEY_ID=
MORAINE_S3_SECRET_ACCESS_KEY=
MORAINE_S3_PREFIX=moraine

# Optional operational protection.
# MORAINE_METRICS_TOKEN=
# MORAINE_REQUESTS_PER_MINUTE=600

# Optional email verification/recovery mail.
# MORAINE_SMTP_URL=smtps://user:password@mail.example:465
# MORAINE_MAIL_FROM=Moraine <noreply@example.com>

# Cloudflare Tunnel is configured separately in Cloudflare. If cloudflared
# runs as a container, keep its token outside this file when possible.
# CLOUDFLARE_TUNNEL_TOKEN=
