{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"browser": true,
		"es2026": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": ["build/**", ".svelte-kit/**", "node_modules/**"],
	"overrides": [
		{
			"files": ["src/app.d.ts"],
			"rules": {
				"unicorn/require-module-specifiers": "off"
			}
		}
	]
}
